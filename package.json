{
  "name": "@integr8-media/ui",
  "version": "0.1.0",
  "description": "Design system for every @integr8-media app: shadcn/ui components on Radix + Tailwind v4, a theme engine with Light, Dark, System and Integr8 themes, a form kit, a data table, a command palette and app layout pieces.",
  "author": "Mina Louis Leon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinaLouisLeon/integr8-ui.git"
  },
  "homepage": "https://github.com/MinaLouisLeon/integr8-ui#readme",
  "bugs": {
    "url": "https://github.com/MinaLouisLeon/integr8-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./registry/*": "./dist/registry/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown && node scripts/buildAssets.mjs && npm run build:css",
    "build:css": "tailwindcss --input src/styles/styles.entry.css --output dist/styles.css --minify",
    "playground": "ladle serve --config playground",
    "playground:build": "ladle build --config playground --outDir playground/dist",
    "playground:smoke": "npm run playground:build && playwright test",
    "check:exports": "publint && attw --pack --profile esm-only --exclude-entrypoints ./theme.css ./styles.css ./fonts.css",
    "docs": "typedoc",
    "prepare": "lefthook install"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/unbounded": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.4.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.5",
    "@integr8-media/config": "^1.0.0",
    "@ladle/react": "^5.0.3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^27.0.1",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.23.5",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.0",
    "vitest": "^5.1.0"
  }
}
